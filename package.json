{
  "name": "dgita-workspace-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && tsx --test tests/*.test.mjs features/application/*.test.mjs features/auth/*.test.mjs features/approval/*.test.mjs features/mail/*.test.mjs",
    "test:e2e": "tsx tests/e2e-local.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern .vinext --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/*.test.mjs features/application/*.test.mjs features/auth/*.test.mjs features/approval/*.test.mjs features/mail/*.test.mjs",
    "build:next": "next build",
    "start:next": "next start",
    "test:ci:e2e": "node scripts/ci-server.mjs e2e",
    "test:ci:production": "node scripts/ci-server.mjs production",
    "db:migrate": "node scripts/migrate.mjs",
    "db:manifest": "node scripts/migration-manifest.mjs",
    "check:production": "node scripts/check-production-config.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@vercel/blob": "2.8.0",
    "drizzle-orm": "0.45.2",
    "geist": "1.7.2",
    "jose": "6.2.12",
    "lucide-react": "^1.34.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261005.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.147.0"
  },
  "type": "module"
}
