# Lokal skabelon. Se docs/production-operations.md før opsætning af drift.
# Ingen værdi her er en credential. Gem faktiske secrets i platformens secretlager.
# Pilot og produktion skal have hver sit projekt, database, private Blob-lager
# og egne credentials. Kopiér aldrig en pilotdatabase ind i produktion.
DGITA_ENVIRONMENT=local
DGITA_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bevarer eksisterende testbrugerflow. Brug kun syntetiske data.
# Offentlig pilot: DGITA_ENVIRONMENT=pilot og særskilt tilfældig testkode >=8 tegn.
# Produktion: begge flag nedenfor skal være false; testkode skal ikke installeres.
DGITA_ENABLE_DEV_LOGIN=true
DGITA_ENABLE_DEMO_SEED=true
DGITA_TEST_ACCESS_SECRET=

# Valgfrie sessionstider i hele sekunder (60..43200, idle <= max).
# Pilotstandard: 12 timer for begge. Produktionsforslag: 12 timer / 30 minutter.
# IAM/systemejer skal acceptere produktionsværdierne før frigivelse.
# DGITA_SESSION_MAX_SECONDS=43200
# DGITA_SESSION_IDLE_SECONDS=1800

# Særskilte secrets på mindst 32 tilfældige tegn. Ingen genbrug mellem formål/miljøer.
# Approval-secret er påkrævet offentligt. Lokal kode har localhost-fallback.
DGITA_APPROVAL_TOKEN_SECRET=

# Vercel Cron kalder GET /api/cron/mail med denne værdi som Bearer-token.
# Brug mindst 32 tilfældige tegn. Verificér faktisk tidsplan i driftsmiljøet.
CRON_SECRET=

# Vercel: Turso/libSQL og PRIVAT Blob. Produktionsschema migreres eksplicit.
# TURSO_DATABASE_URL=libsql://<database-name>-<organisation>.turso.io
# TURSO_AUTH_TOKEN=
# BLOB_STORE_ID=store_<id>
# Blob kan anvende platformens kortlivede OIDC-token; nedenstående er fallback.
# BLOB_READ_WRITE_TOKEN=
# NEXT_PUBLIC_DGITA_UPLOAD_MODE=vercel-blob

# Entra-login er implementeret. Knappen aktiveres kun med komplet konfiguration
# på DGITA_APP_ORIGIN. Registrér callback som Web; én konkret tenant-GUID.
# Brugeren og DB-roller skal være provisioneret på forhånd. Ingen auto-tilmelding.
# DGITA_ENTRA_TENANT_ID=<tenant-guid>
# DGITA_ENTRA_CLIENT_ID=<client-guid>
# DGITA_ENTRA_CLIENT_SECRET=
# DGITA_ENTRA_PORTAL_TENANT_ID=<existing-portal-tenant-id>
# DGITA_ENTRA_REDIRECT_URI=https://portal.example.invalid/api/auth/entra/callback
# Separat højentropi-secret, >=32 tegn, til krypteret state/PKCE-cookie.
# DGITA_OIDC_STATE_SECRET=
# Valgfri; skal matche tenantens præcise Microsoft v2-issuer, hvis sat:
# DGITA_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-guid>/v2.0

# Kommunalt godkendt malwaretjeneste. Produktion afviser nye bilag uden den.
# POST rå bytes; svar: {"verdict":"clean"|"infected","sha256":"<lowercase-hex>"}.
# Dokumentindhold sendes til tjenesten; ejerskab og databehandling skal godkendes.
# DGITA_MALWARE_SCAN_URL=https://scanner.example.invalid/scan
# DGITA_MALWARE_SCAN_TOKEN=
# DGITA_MALWARE_SCAN_TIMEOUT_MS=10000

# Microsoft Graph-mail: særskilt serverapp og begrænset afsenderpostkasse.
# DGITA_GRAPH_TENANT_ID=<tenant-guid>
# DGITA_GRAPH_CLIENT_ID=<client-guid>
# DGITA_GRAPH_CLIENT_SECRET=
# DGITA_GRAPH_SENDER=sender@example.invalid
# Lokal/pilot blokerer al afsendelse, indtil præcise modtagere er tilladt.
# Også cc/bcc/replyTo skal være tilladt. Ingen wildcards. Produktion kan begrænses
# på samme måde; tom værdi i produktion betyder ingen ekstra modtagerbegrænsning.
DGITA_MAIL_ALLOWED_RECIPIENTS=
# DGITA_MAIL_ALLOWED_RECIPIENTS=recipient@example.invalid

# Valgfrie Graph-overrides.
# DGITA_GRAPH_AUTHORITY_HOST=https://login.microsoftonline.com
# DGITA_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# DGITA_GRAPH_SCOPE=https://graph.microsoft.com/.default
# DGITA_GRAPH_TIMEOUT_MS=10000

# Fælleskommunal Adgangsstyring er fortsat en ikke-implementeret integration.
# DGITA_FK_ISSUER=https://<fk-issuer>/
# DGITA_FK_CLIENT_ID=<client-id>
# DGITA_FK_REDIRECT_URI=https://portal.example.invalid/api/auth/fk/callback

# E2E-test bruger ellers http://localhost:3001.
# DGITA_E2E_BASE_URL=http://localhost:3001
